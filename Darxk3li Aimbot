-- HELPERS DE UI
-- ============================================================
local function tween(obj, t, props, style)
    if not obj or not obj.Parent then return end
    local a = TweenService:Create(
        obj,
        TweenInfo.new(t, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )
    a:Play()
    return a
end

local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 12)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thick, transp)
    local s = Instance.new("UIStroke")
    s.Color = color or CONFIG.uiStroke
    s.Thickness = thick or 1
    s.Transparency = transp or 0.3
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

