    RunService:BindToRenderStep(RUN_KEY_ESP, Enum.RenderPriority.Camera.Value + 2, function()
        if not CONFIG.espEnabled then
            for _, data in pairs(espCache) do hideESP(data) end
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        local targets = {}

        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= LocalPlayer then
                local char = otherPlayer.Character
                if isAlive(char) then
                    local skip = false
                    if CONFIG.espTeamCheck and isTeammate(otherPlayer) then
                        skip = true
                    end
                    if not skip then
                        targets[char] = otherPlayer.Name
                    end
                end
            end
        end

        for _, inst in ipairs(workspace:GetChildren()) do
            if inst:IsA("Model") and inst ~= myChar and isAlive(inst) then
                targets[inst] = inst.Name
            end
        end

        for model in pairs(espCache) do
            if not targets[model] or not model.Parent then
                removeESP(model)
            end
        end

        local vp = Camera.ViewportSize
        local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
        local edgePadding = 30

        for model, dispName in pairs(targets) do
            local data = createESP(model)

            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart")
            if not hrp or not myHrp then continue end

            local dist = (myHrp.Position - hrp.Position).Magnitude
            if dist > CONFIG.espMaxDist then
                hideESP(data)
                continue
            end

            -- Projeção dos pontos superior e inferior
            local headPos = hrp.Position + Vector3.new(0, 3, 0)
            local sp, onScreen = Camera:WorldToViewportPoint(headPos)
            local spBottom, onScreenBottom = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            -- Chams: sempre visível (não depende de onScreen)
            if CONFIG.espChams then
                data.chams.Enabled = true
                data.chams.FillColor = CONFIG.espColor
            else
                data.chams.Enabled = false
            end

            -- Arrow: se fora da tela, mostra seta apontando
            if CONFIG.espArrow and not onScreen then
                -- Posição do alvo em screen space
                local relX = sp.X - screenCenter.X
                local relY = sp.Y - screenCenter.Y
                local angle = math.atan2(relY, relX)
                -- Coloca a seta na borda mais próxima do alvo
                local maxX = vp.X / 2 - edgePadding
                local maxY = vp.Y / 2 - edgePadding
                local cos = math.cos(angle)
                local sin = math.sin(angle)
                local scaleX = math.abs(cos) > 0.001 and (maxX / math.abs(cos)) or math.huge
                local scaleY = math.abs(sin) > 0.001 and (maxY / math.abs(sin)) or math.huge
                local scale = math.min(scaleX, scaleY)
                local arrowX = screenCenter.X + cos * scale
                local arrowY = screenCenter.Y + sin * scale
                data.arrow.Visible = true
                data.arrow.Position = UDim2.new(0, arrowX, 0, arrowY)
                data.arrow.Rotation = math.deg(angle)
                data.arrow.TextColor3 = CONFIG.espColor
            else
                data.arrow.Visible = false
            end

            -- Restante só se o alvo está na tela
            if onScreen and onScreenBottom then
                -- Highlight base
                data.highlight.Enabled = true
                data.highlight.FillColor = CONFIG.espColor
                data.highlight.OutlineColor = CONFIG.espColor

                -- Nome
                if CONFIG.espShowName then
                    data.name.Visible = true
                    data.name.Text = dispName
                    data.name.Position = UDim2.new(0, sp.X, 0, sp.Y - 6)
                    data.name.Size = UDim2.new(0, 200, 0, 18)
                else
                    data.name.Visible = false
                end

                -- Distância
                if CONFIG.espShowDistance then
                    data.dist.Visible = true
                    data.dist.Text = string.format("[%d m]", math.floor(dist))
                    data.dist.Position = UDim2.new(0, sp.X, 0, sp.Y + 14)
                    data.dist.Size = UDim2.new(0, 200, 0, 14)
                else
                    data.dist.Visible = false
                end

                -- Barra de vida
                if CONFIG.espShowHealth then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if hum then
                        local boxHeight = math.abs(sp.Y - spBottom.Y)
                        data.healthBg.Visible = true
                        data.healthBg.Position = UDim2.new(0, sp.X - 32, 0, sp.Y)
                        data.healthBg.Size = UDim2.new(0, 4, 0, boxHeight)
                        local hRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        data.healthFill.Size = UDim2.new(1, 0, hRatio, 0)
                        data.healthFill.Position = UDim2.new(0, 0, 1 - hRatio, 0)
                        data.healthFill.BackgroundColor3 = Color3.fromRGB(
                            math.floor(255 * (1 - hRatio) + 46 * hRatio),
                            math.floor(230 * hRatio + 20 * (1 - hRatio)),
                            60
                        )
                    else
                        data.healthBg.Visible = false
                    end
                else
                    data.healthBg.Visible = false
                end

                -- Box 2D
                if CONFIG.espBox then
                    local left   = math.min(sp.X, spBottom.X)
                    local right  = math.max(sp.X, spBottom.X)
                    local top    = math.min(sp.Y, spBottom.Y)
                    local bottom = math.max(sp.Y, spBottom.Y)
                    -- cor por distância (opcional)
                    local p1 = Vector2.new(left, top)
                    local p2 = Vector2.new(right, top)
                    local p3 = Vector2.new(right, bottom)
                    local p4 = Vector2.new(left, bottom)
                    for _, l in ipairs(data.boxLines) do
                        l.Visible = true
                        l.BackgroundColor3 = CONFIG.espColor
                    end
                    updateLine(data.boxLines[1], p1, p2, 1)
                    updateLine(data.boxLines[2], p2, p3, 1)
                    updateLine(data.boxLines[3], p3, p4, 1)
                    updateLine(data.boxLines[4], p4, p1, 1)
                else
                    for _, l in ipairs(data.boxLines) do l.Visible = false end
                end

                -- Skeleton
                if CONFIG.espSkeleton then
                    local pts = {}
                    for _, boneName in ipairs(SKELETON_BONES) do
                        local bone = model:FindFirstChild(boneName)
                        if bone and bone:IsA("BasePart") then
                            local bsp, bOn = Camera:WorldToViewportPoint(bone.Position)
                            if bOn then
                                pts[boneName] = Vector2.new(bsp.X, bsp.Y)
                            end
                        end
                    end
                    local idx = 0
                    for _, line in ipairs(data.skelLines) do line.Visible = false end
                    for _, pair in ipairs(SKELETON_PAIRS) do
                        local a = pts[pair[1]]
                        local b = pts[pair[2]]
                        if a and b then
                            idx = idx + 1
                            local ln = data.skelLines[idx]
                            if ln then
                                ln.Visible = true
                                ln.BackgroundColor3 = CONFIG.espColor
                                updateLine(ln, a, b, 1)
                            end
                        end
                    end
                else
                    for _, l in ipairs(data.skelLines) do l.Visible = false end
                end

                -- Tracer: do centro da tela até o alvo
                if CONFIG.espTracer then
                    data.tracer.Visible = true
                    data.tracer.BackgroundColor3 = CONFIG.espColor
                    -- do fundo da tela (parte inferior central) até a cabeça do alvo
                    local originPt = Vector2.new(screenCenter.X, vp.Y - 10)
                    local targetPt = Vector2.new(sp.X, sp.Y)
                    updateLine(data.tracer, originPt, targetPt, 1)
                else
                    data.tracer.Visible = false
                end
            else
                -- Fora da tela (mas talvez dentro do arrow)
                data.highlight.Enabled = false
                data.name.Visible = false
                data.dist.Visible = false
                data.healthBg.Visible = false
                data.tracer.Visible = false
                for _, l in ipairs(data.boxLines) do l.Visible = false end
                for _, l in ipairs(data.skelLines) do l.Visible = false end
            end
        end
    end)

    _G.AimLabConn = function()
        pcall(function() RunService:UnbindFromRenderStep(RUN_KEY_AIM) end)
        pcall(function() RunService:UnbindFromRenderStep(RUN_KEY_ESP) end)
        for model in pairs(espCache) do removeESP(model) end
    end
end

