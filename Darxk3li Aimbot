    -- --- FPS BOOST ---
    local function applyFPSBoost(enable)
        if enable then
            -- Salva valores originais
            if not FPS_ORIGINALS.saved then
                FPS_ORIGINALS.GlobalShadows = Lighting.GlobalShadows
                FPS_ORIGINALS.ShadowSoftness = Lighting.ShadowSoftness
                FPS_ORIGINALS.EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale
                FPS_ORIGINALS.EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
                FPS_ORIGINALS.FogEnd = Lighting.FogEnd
                FPS_ORIGINALS.saved = true
            end

            Lighting.GlobalShadows = false
            Lighting.ShadowSoftness = 0
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
            Lighting.FogEnd = 100000

            -- Desliga partículas
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail")
                   or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end
        else
            -- Restaura
            if FPS_ORIGINALS.saved then
                if FPS_ORIGINALS.GlobalShadows ~= nil then
                    Lighting.GlobalShadows = FPS_ORIGINALS.GlobalShadows
                end
                if FPS_ORIGINALS.ShadowSoftness ~= nil then
                    Lighting.ShadowSoftness = FPS_ORIGINALS.ShadowSoftness
                end
                if FPS_ORIGINALS.EnvironmentDiffuseScale ~= nil then
                    Lighting.EnvironmentDiffuseScale = FPS_ORIGINALS.EnvironmentDiffuseScale
                end
                if FPS_ORIGINALS.EnvironmentSpecularScale ~= nil then
                    Lighting.EnvironmentSpecularScale = FPS_ORIGINALS.EnvironmentSpecularScale
                end
                if FPS_ORIGINALS.FogEnd ~= nil then
                    Lighting.FogEnd = FPS_ORIGINALS.FogEnd
                end
            end
        end
    end

