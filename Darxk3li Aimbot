    local function updateCrosshair()
        local vp = Camera.ViewportSize
        local cx, cy = vp.X / 2, vp.Y / 2
        local len, gap, thick = 10, 4, CONFIG.fovThickness
        local visible = CONFIG.fovEnabled and CONFIG.showCrosshair

        for _, l in ipairs(crosshairLines) do
            l.Visible = visible
            l.BackgroundColor3 = CONFIG.fovColor
            l.BackgroundTransparency = CONFIG.fovTransparency
        end
        if not visible then return end

        crosshairLines[1].Position = UDim2.new(0, cx - thick/2, 0, cy - len - gap)
        crosshairLines[1].Size     = UDim2.new(0, thick, 0, len)
        crosshairLines[2].Position = UDim2.new(0, cx - thick/2, 0, cy + gap)
        crosshairLines[2].Size     = UDim2.new(0, thick, 0, len)
        crosshairLines[3].Position = UDim2.new(0, cx - len - gap, 0, cy - thick/2)
        crosshairLines[3].Size     = UDim2.new(0, len, 0, thick)
        crosshairLines[4].Position = UDim2.new(0, cx + gap, 0, cy - thick/2)
        crosshairLines[4].Size     = UDim2.new(0, len, 0, thick)
    end

