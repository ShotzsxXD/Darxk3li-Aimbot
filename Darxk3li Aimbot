    local function isAlive(model)
        if not model or not model.Parent then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        return true
    end

    local function getTargetPart(model, boneName)
        local part = model:FindFirstChild(boneName)
        if part and part:IsA("BasePart") then return part end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.RootPart then return hum.RootPart end
        for _, inst in ipairs(model:GetDescendants()) do
            if inst:IsA("BasePart") then return inst end
        end
        return nil
    end

    -- ========================================================
    -- TEAM CHECK UNIVERSAL
    -- ========================================================
    local function getAllTeamMarkers(plr)
        if not plr or not plr.Parent then return {} end
        local markers = {}

        if plr.Team ~= nil then
            markers[#markers + 1] = "T_" .. tostring(plr.Team)
        end
        if plr.TeamColor ~= nil then
            markers[#markers + 1] = "TC_" .. tostring(plr.TeamColor.Number)
            markers[#markers + 1] = "TCN_" .. tostring(plr.TeamColor.Name)
        end
        if plr.Team ~= nil and plr.Team.TeamColor ~= nil then
            markers[#markers + 1] = "TTC_" .. tostring(plr.Team.TeamColor.Number)
            markers[#markers + 1] = "TTCN_" .. tostring(plr.Team.TeamColor.Name)
        end
        if plr.Team ~= nil and plr.Team.Name ~= nil and plr.Team.Name ~= "" then
            markers[#markers + 1] = "TN_" .. tostring(plr.Team.Name):lower()
        end

        local okAttr, playerAttrs = pcall(function() return plr:GetAttributes() end)
        if okAttr and playerAttrs then
            for key, value in pairs(playerAttrs) do
                local keyLower = tostring(key):lower()
                if keyLower:find("team") or keyLower:find("side") or
                   keyLower:find("faction") or keyLower:find("group") then
                    markers[#markers + 1] = "PA_" .. keyLower .. "=" .. tostring(value):lower()
                end
            end
        end

        local char = plr.Character
        if char then
            local okCAttr, charAttrs = pcall(function() return char:GetAttributes() end)
            if okCAttr and charAttrs then
                for key, value in pairs(charAttrs) do
                    local keyLower = tostring(key):lower()
                    if keyLower:find("team") or keyLower:find("side") or
                       keyLower:find("faction") or keyLower:find("group") then
                        markers[#markers + 1] = "CA_" .. keyLower .. "=" .. tostring(value):lower()
                    end
                end
            end

            local ls = char:FindFirstChild("leaderstats") or plr:FindFirstChild("leaderstats")
            if ls then
                for _, stat in ipairs(ls:GetChildren()) do
                    local nameLower = stat.Name:lower()
                    if nameLower:find("team") or nameLower:find("side") or
                       nameLower:find("faction") or nameLower:find("group") then
                        markers[#markers + 1] = "LS_" .. nameLower .. "=" .. tostring(stat.Value):lower()
                    end
                end
            end
        end

        if char then
            local bc = char:FindFirstChildOfClass("BodyColors")
            if bc then
                local torso = bc.TorsoColor3
                local head = bc.HeadColor3
                if torso then
                    markers[#markers + 1] = "BCT_" .. tostring(torso.Number or torso.Name or torso)
                end
                if head then
                    markers[#markers + 1] = "BCH_" .. tostring(head.Number or head.Name or head)
                end
            end
        end

        return markers
    end

    local function isTeammate(otherPlayer)
        if not CONFIG.aimTeamCheck then return false end
        if not otherPlayer or not otherPlayer.Parent then return false end
        if otherPlayer == LocalPlayer then return false end

        local myMarkers = getAllTeamMarkers(LocalPlayer)
        local otherMarkers = getAllTeamMarkers(otherPlayer)

        if #myMarkers == 0 or #otherMarkers == 0 then
            return false
        end

        for _, a in ipairs(myMarkers) do
            for _, b in ipairs(otherMarkers) do
                if a == b then
                    return true
                end
            end
        end

        return false
    end

    -- WALL CHECK
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true

    local function hasWallBetween(targetPart)
        if not CONFIG.aimWallCheck then return false end
        if not targetPart then return true end

        local origin = Camera.CFrame.Position
        local direction = (targetPart.Position - origin)

        local ignoreList = {}
        if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
        if targetPart.Parent then table.insert(ignoreList, targetPart.Parent) end
        raycastParams.FilterDescendantsInstances = ignoreList

        local result = workspace:Raycast(origin, direction, raycastParams)

        if result then
            if result.Instance:IsDescendantOf(targetPart.Parent) then
                return false
            end
            return true
        end
        return false
    end

    local function isValidTarget(model, otherPlayer)
        if not isAlive(model) then return false end
        if model == LocalPlayer.Character then return false end
        if isTeammate(otherPlayer) then return false end
        return true
    end

