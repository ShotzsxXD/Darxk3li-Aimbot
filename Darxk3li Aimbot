    -- ========================================================
    local function getAimTargetInFOV()
        local vp = Camera.ViewportSize
        local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
        local fovRadius = CONFIG.fovRadius

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        local bestModel, bestPart, bestScore = nil, nil, math.huge

        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= LocalPlayer then
                local char = otherPlayer.Character
                if isValidTarget(char, otherPlayer) then
                    local part = getTargetPart(char, CONFIG.aimBone)
                    if part and not hasWallBetween(part) then
                        local okDist = true
                        if myHrp then
                            local dist = (myHrp.Position - part.Position).Magnitude
                            if dist > CONFIG.aimMaxDist then okDist = false end
                        end
                        if okDist then
                            local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local delta = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
                                if delta <= fovRadius and delta < bestScore then
                                    bestScore = delta
                                    bestModel, bestPart = char, part
                                end
                            end
                        end
                    end
                end
            end
        end

        for _, inst in ipairs(workspace:GetChildren()) do
            if inst:IsA("Model") and inst ~= myChar and isAlive(inst) then
                local part = getTargetPart(inst, CONFIG.aimBone)
                if part and not hasWallBetween(part) then
                    local okDist = true
                    if myHrp then
                        local dist = (myHrp.Position - part.Position).Magnitude
                        if dist > CONFIG.aimMaxDist then okDist = false end
                    end
                    if okDist then
                        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local delta = (Vector2.new(sp.X, sp.Y) - screenCenter).Magnitude
                            if delta <= fovRadius and delta < bestScore then
                                bestScore = delta
                                bestModel, bestPart = inst, part
                            end
                        end
                    end
                end
            end
        end

        return bestModel, bestPart
    end

    local function getClosestTargetAnywhere()
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return nil, nil end

        local bestModel, bestPart, bestDist = nil, nil, math.huge

        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= LocalPlayer then
                local char = otherPlayer.Character
                if isValidTarget(char, otherPlayer) then
                    local part = getTargetPart(char, CONFIG.aimBone)
                    if part and not hasWallBetween(part) then
                        local dist = (myHrp.Position - part.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestModel, bestPart = char, part
                        end
                    end
                end
            end
        end

        for _, inst in ipairs(workspace:GetChildren()) do
            if inst:IsA("Model") and inst ~= myChar and isAlive(inst) then
                local part = getTargetPart(inst, CONFIG.aimBone)
                if part and not hasWallBetween(part) then
                    local dist = (myHrp.Position - part.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestModel, bestPart = inst, part
                    end
                end
            end
        end

        return bestModel, bestPart
    end

